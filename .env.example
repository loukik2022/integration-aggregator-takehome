# Integration Aggregator - Environment Configuration Example

PORT=8080
LOG_LEVEL=INFO

# OpenBao Configuration
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=root
OPENBAO_MOUNT_PATH=oauth2
OPENBAO_TIMEOUT=10.0

# Worker & Queue Settings
WORKER_CONCURRENCY=5
STATE_TTL_SECONDS=600
REQUEST_TTL_SECONDS=600
